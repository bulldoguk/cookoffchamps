{
  "name": "cookoffchamps",
  "version": "0.1.0",
  "private": true,
  "description": "Family cookoff voting: organizers set up an event, guests scan a QR code and vote blind, winners are revealed 3rd to 1st.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "npm run build && wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.client.json",
    "db:migrate:local": "wrangler d1 migrations apply cookoffchamps --local",
    "build": "esbuild src/client/main.ts --bundle --minify --sourcemap --format=esm --target=es2022 --outfile=public/app.js && node scripts/build-help.mjs && node scripts/build-printables.mjs",
    "check-publish": "node scripts/check-publish.mjs",
    "e2e": "playwright test",
    "deploy": "npm run build && npm run check-publish && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.0",
    "@cloudflare/workers-types": "5.20261008.1",
    "@playwright/test": "1.64.0",
    "@types/qrcode": "1.5.6",
    "@vitest/coverage-istanbul": "5.0.3",
    "esbuild": "0.28.2",
    "jsdom": "30.1.2",
    "typescript": "5.9.3",
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  },
  "dependencies": {
    "qrcode": "1.5.4"
  },
  "overrides": {
    "miniflare": {
      "undici": "7.30.1"
    },
    "@cloudflare/vitest-plugin": {
      "zod": "4.6.6"
    }
  }
}
