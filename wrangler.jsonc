{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cookoffchamps",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  // The Worker answers /api/* and redirects www; everything else is a static
  // asset from public/.
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  // One public origin. workers.dev is off: magic links point at APP_ORIGIN, and
  // the Turnstile widget only allows cookoffchamps.com.
  "routes": [
    { "pattern": "cookoffchamps.com", "custom_domain": true },
    { "pattern": "www.cookoffchamps.com", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cookoffchamps",
      "database_id": "74ac3418-a37e-4041-a327-77dbbce65fd9",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "cookoffchamps-photos" }],
  // Production values. Local dev and the e2e tests override them from .dev.vars
  // (copy .dev.vars.example), and the unit tests set their own in vitest.config.ts.
  "vars": {
    "EMAIL_MODE": "resend",
    "APP_ORIGIN": "https://cookoffchamps.com",
    "EMAIL_FROM": "hello@cookoffchamps.com",
    // Public by design: the site key is embedded in every page. The secrets are
    // set with `wrangler secret put TURNSTILE_SECRET` and `RESEND_API_KEY`.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFktbyWGH6J6pHxl"
  }
}
