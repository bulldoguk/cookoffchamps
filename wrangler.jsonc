{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cookoffchamps",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  // The Worker answers /api/*; everything else is a static asset from public/.
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cookoffchamps",
      // Placeholder until the real database is created (SW-14).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "cookoffchamps-photos" }],
  "vars": {
    // "log" prints magic links instead of emailing them. Production sets "resend".
    "EMAIL_MODE": "log",
    "APP_ORIGIN": "http://localhost:8787"
  }
}
